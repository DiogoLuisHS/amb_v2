# ==============================================================================
# 🔑 AMB_V2 - Template de Variáveis de Ambiente do Projeto
# Copie este arquivo para .env e preencha suas chaves:
#   cp .env.example .env
# ==============================================================================

# Repositório GitHub ativo (owner/repo)
GITHUB_REPOSITORY=DiogoLuisHS/amb_v2

# Google Jules Cloud API Key (obtenha em https://jules.google.com)
JULES_API_KEY=

# Google Gemini / Antigravity API Key (obtenha em https://aistudio.google.com)
GEMINI_API_KEY=

# Google Stitch SDK (opcional, para prototipagem de UI)
STITCH_API_KEY=
STITCH_PROJECT_ID=

# ------------------------------------------------------------------------------
# ⚙️ Configurações Opcionais de Comportamento
# ------------------------------------------------------------------------------
# Modelo Gemini a ser utilizado (padrão: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# ANTIGRAVITY_MODEL=gemini-2.5-flash

# Tipo de dispositivo padrão para geração Stitch (DESKTOP, MOBILE, TABLET, AGNOSTIC)
# STITCH_DEVICE_TYPE=DESKTOP

# Exigir confirmação manual para chamadas ao Gemini (true / false; padrão: false)
# AMB_GEMINI_CONFIRM=false
