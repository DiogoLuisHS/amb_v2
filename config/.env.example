# ==============================================================================
# 🔑 AMB_V2 - MODELO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo como .env na raiz do seu repositório ou preencha o existente.
# ==============================================================================

# 1. 🎨 GOOGLE STITCH SDK
# Obtenha sua chave em: https://stitch.withgoogle.com
STITCH_API_KEY=

# ID do Projeto padrão no Stitch (ex: 15194701482505107374)
STITCH_PROJECT_ID=

# 2. ⚡ GOOGLE JULES SDK / REST API
# Obtenha sua chave em: https://jules.google.com
JULES_API_KEY=

# Repositório GitHub padrão vinculado ao Jules (ex: usuario/meu-repo)
GITHUB_REPOSITORY=

# 3. 🧠 GOOGLE ANTIGRAVITY & GEMINI
# Obtenha sua chave em: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=

# 4. 🚀 RENDER CLOUD API
# Obtenha sua chave em: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=

# ID do serviço principal no Render (opcional, para deploys e logs rápidos)
RENDER_SERVICE_ID=
